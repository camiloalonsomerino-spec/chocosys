    { "nombre": "OC", "tipo": "abierta", "probabilidad": 90, "requisitos": [
      { "tipo": "documento", "clave": "OC del cliente", "texto": "Orden de compra del cliente", "patron": "\\bOC\\b|orden.de.compra" } ] },
    { "nombre": "Terreno", "tipo": "abierta", "probabilidad": 95, "requisitos": [
      { "tipo": "dato", "clave": "cierre_esperado", "texto": "Fecha de entrega comprometida" } ] },
    { "nombre": "Entrega", "tipo": "abierta", "probabilidad": 95, "requisitos": [
      { "tipo": "documento", "clave": "Acta de entrega", "texto": "Acta, guía o certificado de entrega", "patron": "acta|gu[ií]a|certificad|entrega" } ] },
    { "nombre": "Cobro", "tipo": "abierta", "probabilidad": 95, "requisitos": [
      { "tipo": "documento", "clave": "Factura", "texto": "Factura emitida", "patron": "factura|\\bDTE\\b" } ] },
    { "nombre": "Ganado", "tipo": "ganada", "probabilidad": 100, "requisitos": [
      { "tipo": "documento", "clave": "Comprobante de pago", "texto": "Pago recibido", "patron": "pago|transferencia|comprobante" },
